---
// Overzicht van een sectie (Luidsprekers, Draaitafels, …): intro, eventuele foto's en alle items.
import Base from "../layouts/Base.astro";
import Kaart from "../components/Kaart.astro";
import Icon from "../components/Icon.astro";
import Galerij from "../components/Galerij.astro";
import ContactKnoppen from "../components/ContactKnoppen.astro";
import Foto from "../components/Foto.astro";
import Inklap from "../components/Inklap.astro";
import { Image } from "astro:assets";
import speakerLijn from "../assets/speaker-lijn.png";
import draaitafelLijn from "../assets/turntable-lijn.png";
import { getItems, renderBody, type Page } from "../lib/content";
import { SECTION_ICON, SOORTEN, FILTER_MIN, SECTIE_CTA, type SectionKey } from "../data/site";
import { w, t, contactPath } from "../i18n";

interface Props { page: Page }
const { page } = Astro.props;
const lang = page.lang;
const { Content } = await renderBody(page);
const items = await getItems(page.section, lang);
const heeftTekst = !!(page.lang === "en" && page.en?.body?.trim() ? page.en.body : page.nl.body)?.trim();
// Een sectie met één foto toont die naast de tekst; met meer foto's komt er een galerij.
const enkel = page.photos.length === 1 ? page.photos[0] : undefined;
// Lange intro (meer dan 250 woorden): openingsalinea groot en de rest in twee kolommen, zonder lijntekening ernaast
const lang_ = page.woorden > 250 && !enkel;
// Filtertoetsen: alles, te koop, en de soorten van deze sectie (alleen bij genoeg items)
const tel = (f: (i: (typeof items)[number]) => boolean) => items.filter(f).length;
const filters = items.length >= FILTER_MIN
  ? [
      { id: "alles", naam: w(lang, "everything"), aantal: items.length, led: "" },
      ...(tel((i) => i.forSale) ? [{ id: "koop", naam: w(lang, "forSale"), aantal: tel((i) => i.forSale), led: "groen" }] : []),
      ...(SOORTEN[page.section as SectionKey] ?? []).map((s) => ({ id: s.id, naam: s.naam[lang === "en" ? 1 : 0], aantal: tel((i) => i.soort === s.id), led: "" })).filter((f) => f.aantal > 0),
    ]
  : [];
// Sterke punten: tekst in alinea's (lege regel = nieuwe alinea)
const usps = (page.usps ?? []).map((u) => ({ titel: u.titel, alineas: u.tekst.trim().split(/\n\s*\n/).map((a) => a.replace(/\s*\n\s*/g, " ")) }));
const cta = SECTIE_CTA[page.section as SectionKey];
const ki = lang === "en" ? 1 : 0;
const artwork = page.section === "speakers" ? speakerLijn : ["turntables", "repairs"].includes(page.section) ? draaitafelLijn : undefined;
---
<Base lang={lang} title={page.metaTitle ?? page.title} description={page.metaDescription ?? (page.excerpt || undefined)} alt={page.alt} current={page.section} image={page.cover}>
  <section class="sectie">
    <div class="wrap">
      {enkel ? (
        <header class="sectie-held">
          <div class="sectie-held-tekst">
            <p class="verhaal-kicker mono"><i class="led led-aan" aria-hidden="true"></i>Studio 4 Holland · {t(lang, "Handgemaakt in Nijkerk", "Hand built in Nijkerk")}</p>
            <h1>{page.title}</h1>
            {heeftTekst && <div class="proza sectie-held-lead"><Content /></div>}
            <ContactKnoppen lang={lang} klein />
          </div>
          <figure class="sectie-held-beeld">
            {artwork && <div class="artwork sectie-held-artwork" aria-hidden="true"><Image src={artwork} alt="" width={400} /></div>}
            <Foto src={enkel.src} alt={enkel.alt} sizes="(min-width: 1240px) 680px, (min-width: 900px) 55vw, 100vw" widths={[700, 1200]} loading="eager" fetchpriority="high" />
          </figure>
        </header>
      ) : (
        <div class="tab-rij">
          <h1 class="tab"><Icon name={SECTION_ICON[page.section]} size={26} />{page.title}</h1>
          <ContactKnoppen lang={lang} klein />
        </div>
      )}
      <div class="paneel">
        {usps.length > 0 && (
          <section class="usps" aria-labelledby="usps-kop">
            <h2 id="usps-kop" class="usps-kop mono">{t(lang, "Onze principes", "Our principles")}</h2>
            <ol class="usp-lijst">
              {usps.map((u, n) => (
                <li class="usp">
                  <span class="usp-nr mono" aria-hidden="true"><i class="led led-aan"></i>CH {String(n + 1).padStart(2, "0")}</span>
                  <h3>{u.titel}</h3>
                  <div class="usp-tekst">
                    <p>{u.alineas[0]}</p>
                    {u.alineas.length > 1 && (
                      <details class="usp-meer">
                        <summary><span class="usp-meer-open">{t(lang, "Lees verder", "Read more")}</span><span class="usp-meer-dicht">{t(lang, "Minder", "Less")}</span><Icon name="down" size={14} /></summary>
                        {u.alineas.slice(1).map((a) => <p>{a}</p>)}
                      </details>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}
        {cta && (
          <div class="cta-band">
            <div>
              <p class="cta-kop">{cta.kop[ki]}</p>
              <p>{cta.tekst[ki]}</p>
            </div>
            <a class="knop" href={`${contactPath(lang)}?${new URLSearchParams({ soort: cta.soort, over: page.title, pagina: page.url })}`}><Icon name="mail" size={18} />{cta.knop[ki]}</a>
          </div>
        )}
        {!enkel && heeftTekst && (
          <div class:list={["sectie-intro", { lang: lang_ }]}>
            <Inklap lang={lang}><div class="proza">{page.subtitle && page.subtitle !== page.title && <p class="intro">{page.subtitle}</p>}<Content /></div></Inklap>
            {artwork && !lang_ ? (
              <div class="artwork artwork-draaitafel" aria-hidden="true" style="justify-self:center"><Image src={artwork} alt="" width={400} /></div>
            ) : null}
          </div>
        )}
        {page.photos.length > 1 && <div style="margin-top:var(--r-6)"><Galerij photos={page.photos} lang={lang} titel={page.title} /></div>}
        {filters.length > 2 && (
          <div class="filterbalk" data-filter hidden style={heeftTekst || page.photos.length ? "margin-top:var(--r-7)" : undefined}>
            <div class="filter-toetsen" role="group" aria-label={lang === "en" ? "Filter by type" : "Filter op soort"}>
              {filters.map((f) => (
                <button type="button" class="toets" data-soort={f.id} aria-pressed={f.id === "alles" ? "true" : "false"}>
                  <i class:list={["led", { "led-groen": f.led === "groen" }]} aria-hidden="true"></i>{f.naam}<span class="tel mono">{f.aantal}</span>
                </button>
              ))}
            </div>
            <div class="filter-teller">
              <span class="mono filter-teller-label" aria-hidden="true">{lang === "en" ? "Counter" : "Teller"}</span>
              <span class="teller mono" aria-live="polite"><span class="visually-hidden">{lang === "en" ? "Shown: " : "Getoond: "}</span><span data-teller>{String(items.length).padStart(3, "0")}</span></span>
            </div>
          </div>
        )}
        {items.length > 0 && usps.length > 0 && <h2 class="usps-kop mono werk-kop">{t(lang, "Het werk", "The work")}</h2>}
        {items.length > 0 && (
          <ul class="kaarten" data-kaarten style={filters.length > 2 ? "margin-top:var(--r-5)" : heeftTekst || page.photos.length ? "margin-top:var(--r-7)" : undefined}>
            {items.map((i, n) => (
              <li data-soort={i.soort ?? ""} data-koop={i.forSale ? "" : undefined} style={`view-transition-name:kaart-${n}`}>
                <Kaart item={i} eager={n < 3} sizes="(min-width: 1240px) 380px, (min-width: 700px) 45vw, 100vw" />
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>
</Base>

<script>
  // Filteren zonder herladen. De keuze staat in het adres (?soort=hout), zodat je hem kunt delen of terugkomt waar je was.
  // Zonder JavaScript is de filterbalk er niet en zie je gewoon alles.
  const balk = document.querySelector<HTMLElement>("[data-filter]");
  const lijst = document.querySelector<HTMLElement>("[data-kaarten]");
  if (balk && lijst) {
    balk.hidden = false;
    const knoppen = [...balk.querySelectorAll<HTMLButtonElement>("button[data-soort]")];
    const kaarten = [...lijst.querySelectorAll<HTMLLIElement>(":scope > li")];
    const teller = balk.querySelector<HTMLElement>("[data-teller]")!;
    const past = (li: HTMLLIElement, s: string) => s === "alles" || (s === "koop" ? li.hasAttribute("data-koop") : li.dataset.soort === s);
    const kies = (s: string, animeer = true) => {
      if (!knoppen.some((k) => k.dataset.soort === s)) s = "alles";
      const zet = () => {
        knoppen.forEach((k) => k.setAttribute("aria-pressed", String(k.dataset.soort === s)));
        let n = 0;
        kaarten.forEach((li) => { const ja = past(li, s); li.hidden = !ja; if (ja) n++; });
        teller.textContent = String(n).padStart(3, "0");
      };
      const stil = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (animeer && !stil && "startViewTransition" in document) (document as any).startViewTransition(zet);
      else zet();
      const url = new URL(location.href);
      if (s === "alles") url.searchParams.delete("soort"); else url.searchParams.set("soort", s);
      history.replaceState(null, "", url);
    };
    knoppen.forEach((k) => k.addEventListener("click", () => kies(k.dataset.soort!)));
    kies(new URLSearchParams(location.search).get("soort") ?? "alles", false);
  }
</script>
