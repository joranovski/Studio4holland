---
import Base from "../layouts/Base.astro";
import Deck from "../components/Deck.astro";
import Kaart from "../components/Kaart.astro";
import Icon from "../components/Icon.astro";
import Foto from "../components/Foto.astro";
import Inklap from "../components/Inklap.astro";
import { Image } from "astro:assets";
import speakerLijn from "../assets/speaker-lijn.png";
import { getSection, getUitgelicht, getTeKoop, getItems, renderBody } from "../lib/content";
import { HOME_RIJEN, INGANG_FOTO, SECTION_ICON, site } from "../data/site";
import { t, w, teKoopPath, contactPath, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const home = (await getSection("home", lang))!;
const { Content } = await renderBody(home);
const teKoop = await getTeKoop(lang);
const rijen = await Promise.all(
  HOME_RIJEN.map(async ({ sectie, max }) => ({ key: sectie, sectie: await getSection(sectie, lang), items: await getUitgelicht(sectie, lang, max) })),
);

// Foto voor een ingang: de hoofdfoto van een sectie ("repairs") of van een item ("turntables/color-collection")
async function fotoVan(pad: string) {
  const [sectie, item] = pad.split("/");
  const p = item ? (await getItems(sectie, lang, { all: true })).find((i) => i.id === pad) : await getSection(sectie, lang);
  return p?.cover ?? p?.photos[0]?.src;
}
const turntables = await getSection("turntables", lang);
const ingangen = [
  {
    nr: "01", label: t(lang, "Repareren", "Repair"), led: "aan",
    titel: t(lang, "Reparatie of onderhoud", "Repair or service"),
    tekst: t(lang, "Draait je Technics niet meer zoals hij moet? Van pitch tot toonarm: we krijgen hem weer aan de praat.", "Is your Technics not running the way it should? From pitch to tonearm, we'll get it going again."),
    actie: t(lang, "Reparatie aanvragen", "Request a repair"),
    url: `${contactPath(lang)}?soort=reparatie`,
    foto: await fotoVan(INGANG_FOTO.reparatie),
    alt: t(lang, "Een geopende Technics op de werkbank", "An opened-up Technics on the workbench"),
  },
  {
    nr: "02", label: t(lang, "Op maat", "Bespoke"), led: "",
    titel: t(lang, "Iets op maat laten maken", "Have something made to order"),
    tekst: t(lang, "Een custom SL in jouw kleur, speakers die in je ruimte passen of Hextech-voetjes.", "A custom SL in your colour, speakers that fit your room, or Hextech feet."),
    actie: t(lang, "Bekijk het werk", "See the work"),
    url: turntables?.url ?? `/${lang}`,
    foto: await fotoVan(INGANG_FOTO.maat),
    alt: t(lang, "Technics-draaitafels in allerlei kleuren", "Technics turntables in all sorts of colours"),
  },
  ...(teKoop.length
    ? [{
        nr: "03", label: t(lang, "Kopen", "Buy"), led: "groen",
        titel: w(lang, "forSale"),
        tekst: t(lang, "Gereviseerde decks, speakers en hifi. Alles op één plek; bel voor de prijs.", "Refurbished decks, speakers and hi-fi. All in one place; call for the price."),
        actie: t(lang, `${teKoop.length} ${teKoop.length === 1 ? "item" : "items"} te koop`, `${teKoop.length} ${teKoop.length === 1 ? "item" : "items"} for sale`),
        url: teKoopPath(lang),
        foto: teKoop.map((i) => i.cover ?? i.photos[0]?.src).find(Boolean),
        alt: teKoop[0].title,
        sticker: true,
      }]
    : []),
];

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.name,
  url: site.url,
  email: site.email,
  telephone: site.phone.replace(/\s/g, ""),
  image: new URL("/icon-512.png", site.url).href,
  foundingDate: String(site.since),
  founder: { "@type": "Person", name: site.owner },
  address: { "@type": "PostalAddress", streetAddress: site.street, postalCode: site.zip, addressLocality: site.city, addressCountry: "NL" },
  description: site.description[lang],
};
---
<Base lang={lang} title={home.metaTitle ?? home.title} description={home.metaDescription ?? site.description[lang]} alt={home.alt} current="home" schema={schema}>
  <section class="held">
    <div class="wrap">
      <p class="held-boven mono">Studio 4 Holland · Nijkerk · {t(lang, "sinds", "since")} {site.since}</p>
      <h1 class="held-kop">{t(lang, "Waarmee kunnen we je helpen?", "How can we help you?")}</h1>
      <p class="held-intro">{home.metaDescription ?? site.description[lang]}</p>
      <ul class="ingangen">
        {ingangen.map((g, n) => (
          <li>
            <a class="ingang" href={g.url}>
              <div class="ingang-beeld">
                {g.foto && <Foto src={g.foto} alt={g.alt} widths={[480, 900]} sizes="(min-width: 1240px) 400px, (min-width: 760px) 33vw, 100vw" loading="eager" fetchpriority={n === 0 ? "high" : undefined} />}
                {g.sticker && <span class="sticker">{w(lang, "forSale")}</span>}
              </div>
              <div class="ingang-tekst">
                <span class="ingang-label mono"><i class:list={["led", { "led-aan": g.led === "aan", "led-groen": g.led === "groen" }]} aria-hidden="true"></i>{g.nr} · {g.label}</span>
                <h2>{g.titel}</h2>
                <p>{g.tekst}</p>
                <span class="ingang-actie">{g.actie} <Icon name="arrow" size={16} /></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sectie" style="padding-top:0">
    <div class="wrap">
      <h2 class="tab"><Icon name="home" size={20} />{home.title}</h2>
      <div class="paneel welkom-raster">
        <Inklap lang={lang}><div class="proza welkom-tekst"><Content /></div></Inklap>
        <div class="welkom-deck">
          <Deck lang={lang} />
          <p class="deck-uitleg">{t(lang, "Druk op Start/Stop, kies 33 of 45 en speel met de pitch.", "Press Start/Stop, pick 33 or 45 and play with the pitch.")}</p>
        </div>
      </div>
    </div>
  </section>

  {rijen.filter((r) => r.sectie && r.items.length).map((r) => (
    <section class="sectie">
      <div class="wrap">
        <div class="sectie-kop">
          <h2><Icon name={SECTION_ICON[r.key]} size={28} />{r.sectie!.title}</h2>
          <a href={r.sectie!.url}>{w(lang, "all")} <Icon name="arrow" size={16} /></a>
        </div>
        <ul class="kaarten kaarten-strip">
          {r.items.map((i) => <li><Kaart item={i} sizes="(min-width: 1240px) 400px, (min-width: 700px) 45vw, 100vw" /></li>)}
        </ul>
      </div>
    </section>
  ))}

  <div class="artwork artwork-speaker" aria-hidden="true"><Image src={speakerLijn} alt="" width={438} /></div>
</Base>
