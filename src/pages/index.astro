---
// De voordeur: Netlify stuurt bezoekers al door naar /nl/ of /en/ (zie netlify.toml).
// Deze pagina is de terugval, bijvoorbeeld tijdens "npm run dev".
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <title>Studio 4 Holland</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://www.studio4holland.nl/nl" />
    <meta http-equiv="refresh" content="0; url=/nl" />
    <script is:inline>location.replace((navigator.language || "").toLowerCase().startsWith("nl") ? "/nl" : "/en");</script>
  </head>
  <body style="background:#1e1e1e;color:#fff;font-family:sans-serif">
    <p><a href="/nl" style="color:#ff8a52">Nederlands</a> · <a href="/en" style="color:#ff8a52">English</a></p>
  </body>
</html>
