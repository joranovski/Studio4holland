---
import Base from "../layouts/Base.astro";
import ContactKnoppen from "../components/ContactKnoppen.astro";
---
<Base lang="nl" title="Niet gevonden" noindex>
  <section class="wrap niet-gevonden">
    <div class="kras" aria-hidden="true"></div>
    <div>
      <p class="mono" style="color:var(--oranje-300);letter-spacing:.16em;text-transform:uppercase;font-size:.8rem">404 · De naald slaat over</p>
      <h1>Deze pagina bestaat niet (meer)</h1>
      <p>Misschien is hij verhuisd toen de site vernieuwd werd. Kijk op de <a href="/nl/">homepage</a> of neem contact op.</p>
      <p lang="en">This page doesn't exist (anymore). <a href="/en/">Go to the English homepage</a>.</p>
      <ContactKnoppen lang="nl" klein />
    </div>
  </section>
</Base>
