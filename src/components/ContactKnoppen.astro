---
// Mailen, bellen en de milieuregel: dezelfde knoppen als op de oude site, nu als toetsen.
import Icon from "./Icon.astro";
import { site } from "../data/site";
import { w, type Lang } from "../i18n";

interface Props { lang: Lang; prijs?: boolean; klein?: boolean }
const { lang, prijs = false, klein = false } = Astro.props;
---
<div class:list={["contact-knoppen", { klein }]}>
  <a class="knop knop-oranje" href={`mailto:${site.email}`}><Icon name="mail" size={18} /><span>{w(lang, "mail")}</span></a>
  <a class:list={["knop", prijs ? "knop-groen" : "knop-oranje"]} href={site.phoneHref}><Icon name="phone" size={18} /><span>{w(lang, prijs ? "callForPrice" : "call")}</span></a>
  {!klein && <span class="knop knop-stil"><Icon name="recycle" size={18} /><span>{w(lang, "eco")}</span></span>}
</div>
